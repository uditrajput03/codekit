# Backend Environment Variables
# Copy this file to .env and fill in the actual values

# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Secret for Authentication (use a strong random string)
JWT_SECRET="your-super-secret-jwt-key-here"

# Email Service (Resend API Key)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"

# Telegram Bot (for Contact Form Notifications)
BOT_TOKEN="your-telegram-bot-token"

# Payment Gateway (Cashfree)
CASHFREE_CLIENT_ID="your-cashfree-client-id"
CASHFREE_CLIENT_SECRET="your-cashfree-client-secret"
CASHFREE_LINK="https://api.cashfree.com/pg"

# Bcrypt Rounds (password hashing, default: 10)
BCRYPT_ROUNDS="10"